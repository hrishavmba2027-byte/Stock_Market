# =============================================================================
# Stock Market Automation — environment template
#
# Copy this to `.env` and fill in your secrets. `.env` is gitignored;
# `.env.example` is the committed reference. Keep the two in sync when you
# add new settings.
# =============================================================================


# -----------------------------------------------------------------------------
# Google Sheets / Cloud (REQUIRED)
# -----------------------------------------------------------------------------
# Path to the Google service account JSON for direct (non-Docker) runs.
# Relative paths resolve against the repo root, so a fresh clone works on
# any machine. The repo's .gitignore already excludes credentials/*.json,
# so place the file under credentials/ locally and point these at it.
GOOGLE_APPLICATION_CREDENTIALS=./credentials/your-service-account-here.json
GOOGLE_CREDENTIALS=./credentials/your-service-account-here.json

# Just the filename portion of the credentials JSON — used by docker-compose
# to know which file under credentials/ to mount. The compose mount remaps
# it to a canonical /app/credentials/service-account.json inside the
# container, so the rest of the app doesn't care about the long filename.
CREDENTIALS_FILE=your-service-account-here.json

# The "real OHLCV" Google Sheet. Defaults to the project sheet if unset.
SHEET_ID=1uekPHyvJj4p6YjxNwlBBIAI71SWRye-xxFu47Kgpf9o

# Operational (live OHLCV) sheet and the historical training-archive sheet.
OPERATIONAL_SHEET_ID=your_operational_sheet_id_here
HISTORICAL_TRAINING_SHEET_ID=your_historical_training_sheet_id_here


# -----------------------------------------------------------------------------
# Train / test / backtest window boundaries (YYYY-MM-DD)
# -----------------------------------------------------------------------------
TRAIN_END=2023-12-31
TEST_END=2025-06-30
BACK_TEST_START=2025-07-01
BACK_TEST_END=2025-12-31

# Daily circuit-limit (price band) used to bound model forecasts. A horizon-h
# forecast can never move more than h consecutive limit-up/limit-down sessions
# away from the anchor close (default 0.10 = 10% per day, NSE-style band).
# Read by Notebooks/model_2_GPU_.ipynb at training time and recorded in
# outputs/pipeline_metadata.json for inference.
DAILY_CIRCUIT_PCT=0.10


# -----------------------------------------------------------------------------
# Forecasting + operational sheet retention / monthly fine-tuning
# -----------------------------------------------------------------------------
FORECAST_DAYS=15
ROLLING_OPERATIONAL_ROWS=60
FINE_TUNE_BATCH_ONLY_NEW_DATA=true
MONTHLY_FINETUNE_STATE_FILE=state/monthly_finetune_state.json

# Automatic incremental retraining (never a full-dataset retrain).
# run_full_workflow.py stage 15 invokes `monthly_finetune.py --if-due` after
# each successful run. The fine-tune fires when RETRAIN_INTERVAL_DAYS have
# elapsed since the last successful fine-tune, or earlier when the median
# active stock already has MIN_NEW_ROWS_FOR_FINETUNE rows the models were
# never trained on. Checkpoints are overwritten atomically in place
# (outputs/Saved_Models/{Dense,LSTM,Transformer}.pt) so nothing else changes.
AUTO_FINETUNE_AFTER_WORKFLOW=true
# Primary retrain cadence in days (default 15). Replaces the old month-boundary
# trigger: the model retrains every ~15 days once any new data exists.
RETRAIN_INTERVAL_DAYS=15
MIN_NEW_ROWS_FOR_FINETUNE=30

# (P2 — pending) The separate Google Sheet that will hold 30-day predicted
# price paths + Claude's trade signals. Provided by you once created.
# PREDICTIONS_SHEET_ID=

# -----------------------------------------------------------------------------
# Firebase (news + sentiment-analysis storage)
# -----------------------------------------------------------------------------
# Dedicated Firebase project's Admin SDK service-account JSON. All Firestore
# writes (news, sentiment, reddit, X, fundamentals) use this account when set;
# unset → falls back to GOOGLE_CREDENTIALS. Relative → repo root.
FIREBASE_CREDENTIALS=./credentials/your-firebase-adminsdk.json
# Optional explicit project id; unset → read from the credentials JSON.
# FIREBASE_PROJECT=

# Legacy Firestore project override (used only when FIREBASE_* are unset).
# FIRESTORE_PROJECT=
# Collection name for fundamentals docs (P1.1). Doc id is `{TICKER}`
# (e.g. RELIANCE), with recent quarters nested under `quarters`.
FIRESTORE_FUNDAMENTALS_COLLECTION=fundamentals


# -----------------------------------------------------------------------------
# Reddit (anonymous JSON scrape — no API keys, since Reddit Data API access
# was rejected). The User-Agent is the only knob; Reddit's policy is to
# identify yourself honestly, so include a contact or repo name.
# -----------------------------------------------------------------------------
REDDIT_USER_AGENT=stock-market-automation/0.1 (anonymous scrape)


# -----------------------------------------------------------------------------
# Slack notifications (OPTIONAL)
# -----------------------------------------------------------------------------
# Leave empty to disable. When set, the workflow runner posts run summaries.
SLACK_WEBHOOK_URL=
SLACK_NOTIFY_SUCCESS=false
SLACK_NOTIFY_FAILURES=true


# -----------------------------------------------------------------------------
# GLM LLM decision layer (features/trade_suggestions.py)
# -----------------------------------------------------------------------------
# Turns forecasts + sentiment into buy/sell/stop-loss suggestions stored in
# Firestore `trade_suggestions`. Any OpenAI-compatible endpoint works.
GLM_API_KEY=your_glm_or_ollama_cloud_api_key_here
GLM_BASE_URL=https://ollama.com/v1
GLM_MODEL=glm-4.7


# -----------------------------------------------------------------------------
# Anthropic / Claude API (P3 — pending)
# -----------------------------------------------------------------------------
# Required once the Claude decision layer ships. Get a key at
# https://console.anthropic.com/. The cost cap below short-circuits a run
# if the pre-flight token estimate would exceed the budget.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MAX_USD_PER_RUN=2


# -----------------------------------------------------------------------------
# OHLCV update job (Data_update.py)
# -----------------------------------------------------------------------------
UPDATE_START_DATE=2015-01-01
UPDATE_INTERVAL=1d


# -----------------------------------------------------------------------------
# Inference (main.py)
# -----------------------------------------------------------------------------
# PyTorch device. "auto" picks CUDA → MPS → CPU.
DEVICE=auto


# -----------------------------------------------------------------------------
# Sentiment pipeline (P1.5 — features/sentiment.py)
# -----------------------------------------------------------------------------
# FinBERT (~440MB) downloaded from HuggingFace on first run, then cached.
SENTIMENT_MODEL=ProsusAI/finbert
# How far back social/news ingest jobs reach. yfinance .news only returns
# ~30d regardless, X scraping is closer to ~7d.
SENTIMENT_BACKFILL_DAYS=90
# Recency weight-decay half-life (days) for sentiment aggregation. Newer
# headlines dominate the per-day mean; weight halves every SENTIMENT_HALFLIFE_DAYS
# as you move back in time, so the oldest headline in the trailing news window
# (NEWS_LOOKBACK_DAYS) carries the least weight. The 3-day window decays twice
# as fast. Default 3.0.
SENTIMENT_HALFLIFE_DAYS=3.0
# Trailing news window (days). Each news run re-scrapes this window; headlines
# older than now - NEWS_LOOKBACK_DAYS are dropped at fetch and pruned from the
# parquet cache. Default 7 keeps news aligned to the short swing horizon.
NEWS_LOOKBACK_DAYS=7


# -----------------------------------------------------------------------------
# Ingestion collection toggles
# -----------------------------------------------------------------------------
# true  = fetch fresh data, stage it, then upload pending/new archive rows.
# false = skip fresh collection and only drain any pending Firestore archive.
COLLECT_FUNDAMENTALS=true
COLLECT_NEWS=true
COLLECT_REDDIT=true
COLLECT_X=true
REQUEST_MAX_RETRIES=5
# Fresh fundamentals/technicals refresh cadence in days (default 15). The
# scheduler may invoke the job more often, but a fresh yfinance scrape only
# runs once every FUNDAMENTALS_REFRESH_DAYS; off-cadence runs drain-only.
# State is tracked in state/fundamentals_state.json; use --force to override.
FUNDAMENTALS_REFRESH_DAYS=15
# Phase 3 — collect news per company AND per sector (plus GENERAL macro). The
# LLM then sees the company's own sentiment + its sector's sentiment + GENERAL.
ENABLE_SECTOR_NEWS=true
# Phase 3 — point-in-time (PIT) data spine: mirror each ingest run into
# append-only, as-of-dated parquet so a past date's inputs are reconstructable.
ENABLE_PIT_ARCHIVE=false
PIT_ARCHIVE_DIR=./Data/pit


# -----------------------------------------------------------------------------
# Backtesting (Phase 3+) — FULLY LOCAL: no Firestore, no Google Sheet. Prices come
# from the local training workbook and news/sentiment from a local Excel workbook.
# These values are used ONLY by the backtest pipeline (BacktestSettings), never by
# production. Leave BACKTEST_ENABLED=false to keep the backtest jobs inert.
# -----------------------------------------------------------------------------
BACKTEST_ENABLED=false
# Simulation window (inclusive). Empty end date = up to today.
BACKTEST_START_DATE=2020-01-01
BACKTEST_END_DATE=
# Universe to backtest — comma-separated tickers; empty = full NIFTY universe.
BACKTEST_TICKERS=
# News aggregation / collection cadence in days (mirrors NEWS_LOOKBACK_DAYS, 7).
BACKTEST_NEWS_INTERVAL_DAYS=7
# Local news workbook — the single source the simulation reads for news/sentiment
# (sheets: News, Sentiment, Manifest). Written by `python -m backtesting.fetch_news`.
BACKTEST_NEWS_WORKBOOK_PATH=./Data/archive/backtest_news.xlsx
# Wayback CDX historical news scraper knobs.
BACKTEST_CDX_PAUSE_SECONDS=1.0
BACKTEST_CDX_RETRIES=3
BACKTEST_CDX_RATE_LIMIT_WAIT_SECONDS=15.0
BACKTEST_NEWS_CONTENT_WORKERS=32
BACKTEST_NEWS_FETCH_RETRIES=5
BACKTEST_DATA_DIR=./backtesting/data
# Separate backtest MODEL artifacts — the production model in outputs/Saved_Models
# is never touched. The backtest model is trained on point-in-time data here.
BACKTEST_MODEL_DIR=./outputs/backtest/Saved_Models
BACKTEST_METADATA_PATH=./outputs/backtest/pipeline_metadata.json
BACKTEST_FINETUNE_STATE_FILE=./state/backtest_finetune_state.json
BACKTEST_OUTPUT_DIR=./outputs/backtest/monthly_finetune
# ── Phase-4 walk-forward harness (portfolio deployment + bookkeeping) ─────────
# Book size and deployment cadence. Capital is only ever PARTIALLY deployed: a
# cash reserve (CASH_FLOOR_FRAC of equity) is always retained so the book can
# never be drawn to zero, and cash can never go negative.
BACKTEST_INITIAL_CAPITAL=10000000
BACKTEST_RETRAIN_INTERVAL_DAYS=15
BACKTEST_SENTIMENT_INTERVAL_DAYS=7
BACKTEST_FORECAST_DAYS=15
BACKTEST_CASH_FLOOR_FRAC=0.10
BACKTEST_PER_NAME_CAP_FRAC=0.20
BACKTEST_VOL_TARGET_ANNUAL=0.20
BACKTEST_LLM_CONFIDENCE_TILT=0.25
BACKTEST_MIN_TICKET_INR=10000
# Risk-reward edge a new BUY must beat an existing holding by before capital is
# rotated out of the holding to fund it (cash-exhaustion reallocation).
BACKTEST_REALLOCATION_EDGE=0.15
# Conviction-scaled deployment: HOW MUCH of the book to deploy scales with the
# BUY set's weighted risk-reward. Mediocre deals deploy only DEPLOY_FLOOR_FRAC
# (keep cash at hand); deployment reaches 100% (exhaust cash) only when weighted
# risk-reward hits RR_FULL_DEPLOY.
BACKTEST_DEPLOY_FLOOR_FRAC=0.30
BACKTEST_RR_MIN_DEPLOY=1.0
BACKTEST_RR_FULL_DEPLOY=3.0
# Target/stop profit-booking: every bar, a held name whose LLM target (sell_price)
# is touched is sold same-bar and the freed cash held until a fresh suggestion.
# HONOR_STOPLOSS also arms the protective stop (keeps the backtest symmetric —
# books losers as well as winners). Strictly point-in-time (uses only that bar's OHLC).
BACKTEST_HONOR_STOPLOSS=true
BACKTEST_COST_BPS_ROUNDTRIP=40
BACKTEST_SLIPPAGE_ATR_MULT=0.10
BACKTEST_BENCHMARK_SYMBOL=^NSEI
BACKTEST_REPORTING_LAG_DAYS=45
BACKTEST_SEED_EPOCHS=60
# Local artefacts (bookkeeping workbook = every LLM suggestion, allocation,
# sale amount and the final P&L; resumable state; report/charts).
BACKTEST_BOOKKEEPING_PATH=./outputs/backtest/backtest_bookkeeping.xlsx
BACKTEST_STATE_PATH=./outputs/backtest/state/backtest_state.json
BACKTEST_REPORT_DIR=./outputs/backtest/report
BACKTEST_WORKBOOK_PATH=./Data/archive/nse_stock_data_train_filled.xlsx
BACKTEST_INDEX_CACHE_PATH=./Data/archive/indices.parquet
BACKTEST_SENTIMENT_CACHE_PATH=./outputs/backtest/sentiment_cache.parquet

# -----------------------------------------------------------------------------
# Production fund-allocation layer (features.portfolio_allocation)
# -----------------------------------------------------------------------------
# The live allocation advisor sizes the LLM BUY set with the SAME Markowitz +
# cash-guard engine the backtest uses, and writes user-facing advice to a local
# Excel workbook. Same guarantees: partial deployment, no negative cash, and
# capital is only rotated out of a weaker holding when a BUY beats it on
# risk-reward by ALLOC_REALLOCATION_EDGE.
ALLOC_INITIAL_CAPITAL=1000000
ALLOC_CASH_FLOOR_FRAC=0.10
ALLOC_PER_NAME_CAP_FRAC=0.20
ALLOC_VOL_TARGET_ANNUAL=0.20
ALLOC_LLM_CONFIDENCE_TILT=0.25
ALLOC_MIN_TICKET_INR=10000
ALLOC_REALLOCATION_EDGE=0.15
# Conviction-scaled deployment (partial allocation; exhaust cash only for great deals).
ALLOC_DEPLOY_FLOOR_FRAC=0.30
ALLOC_RR_MIN_DEPLOY=1.0
ALLOC_RR_FULL_DEPLOY=3.0
ALLOC_RISK_FREE_ANNUAL=0.0
# Final website-facing suggestion collection (one doc per stock): BUY carries
# target/stop/allocation-% + reason, AVOID carries the reason, HOLD is stored with
# display=false so the front-end ignores it. Written after every LLM suggestion run.
FINAL_SUGGESTIONS_FIRESTORE_COLLECTION=final_suggestions


# -----------------------------------------------------------------------------
# Parquet artifact paths (P1 + P2)
# -----------------------------------------------------------------------------
# These default to the BASE_DIR/Data/ folder; override only if you want to
# store ingested data elsewhere (e.g. a mounted volume).
FUNDAMENTALS_PATH=./Data/archive/fundamentals.parquet
NEWS_PATH=./Data/archive/news.parquet
REDDIT_PATH=./Data/archive/reddit_posts.parquet
X_PATH=./Data/archive/x_posts.parquet
SENTIMENT_PATH=./Data/archive/sentiment_features.parquet
INDICES_PATH=./Data/archive/indices.parquet


# -----------------------------------------------------------------------------
# Workflow orchestration (FastAPI + watcher)
# -----------------------------------------------------------------------------
# Watcher polls the sheet every N seconds. Lower = more responsive,
# higher = fewer API calls. Default 10s works for personal use.
WATCHER_POLL_SECONDS=10

# Subprocess runner (Data_update.py / main.py launched from the API).
SUBPROCESS_TIMEOUT_SECONDS=1800
SUBPROCESS_RETRIES=2

# Google Sheets retry policy.
GOOGLE_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0

# Inter-service base URL inside docker-compose. Override only if you rename
# the api service or run it on a non-standard port.
API_BASE_URL=http://api:8000
API_TIMEOUT_SECONDS=30

# LangChain router mode. "deterministic" is the only supported mode today;
# Claude-backed routing arrives in P3.
LANGCHAIN_MODE=deterministic


# -----------------------------------------------------------------------------
# Paths (rarely overridden)
# -----------------------------------------------------------------------------
# Override only if you've moved the project layout. Defaults derive from
# BASE_DIR which is the repo root.
# BASE_DIR=
# LOGS_DIR=./logs
# APP_LOG_PATH=./logs/app.log
# ERROR_LOG_PATH=./logs/error.log
# OUTPUTS_DIR=./outputs
# OUTPUT_DIR=./outputs/main_inference
# MODEL_DIR=./outputs/Saved_Models
# METADATA_PATH=./outputs/pipeline_metadata.json
# WORKBOOK=./Data/nse_stock_data.xlsx
# WORKFLOW_STATE_PATH=./workflow_state.json
